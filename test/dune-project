(lang dune 3.20)

(name dunolint-actions-test)

(generate_opam_files)

(license "MIT")

(authors "Mathieu Barbin")

(maintainers "Mathieu Barbin <opensource@mbarbin.org>")

(source
 (github mbarbin/dunolint-actions))

(implicit_transitive_deps false)

(package
 (name dunolint-actions-test)
 (synopsis "A dunolint config to test the dunolint-actions repo")
 (depends
  (ocaml
   (>= 4.14))
  ;; The version of dunolint-lib used here must match the version of the
  ;; [dunolint] binary installed by the [dunolint-using-local-actions] CI
  ;; workflow. This is because the config files generated by [main.ml] using
  ;; [dunolint-lib] must be compatible with the binary that will parse them.
  ;;
  ;; When upgrading, ensure that the chosen version is available BOTH:
  ;; 1. On the public opam-repository (which typically lags behind releases), AND
  ;; 2. As a pre-compiled binary on the dunolint GitHub releases page.
  ;;
  ;; Then update the following places in sync:
  ;; - This version pin below
  ;; - The [dunolint-version] input in [.github/workflows/dunolint-using-local-actions.yml]
  ;; - The digest in [setup-dunolint/DIGESTS.md] (if not already listed)
  (dunolint-lib
   (= 0.0.20260211))))
